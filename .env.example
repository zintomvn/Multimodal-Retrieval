# APP_ENV=cloud
# API_HOST=0.0.0.0
# API_PORT=8000
# WEB_PORT=5173

# # Supabase PostgreSQL
# # Lấy từ: Supabase Project Dashboard (E.g: AIC2026) > Connect > Direct > Connection Method: Transaction Pooler > Type: URI > Connection string
# # Transaction Pooler (port 6543) — khuyến nghị cho serverless/container
# DATABASE_URL=postgresql+psycopg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# # e.g: DATABASE_URL=postgresql+psycopg:postgresql://postgres.aaboplzhqhnoycklbwdd:[YOUR-PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres

# # Redis (local hoặc thay bằng Upstash nếu cần cloud)
# REDIS_URL=redis://redis:6379/0
# # e.g: REDIS_URL=redis://localhost:6379/0

# # Zilliz Cloud (managed Milvus)
# # Lấy từ: Zilliz Console > Cluster > Connect > Public Endpoint + API Key
# MILVUS_URI=https://xxx-xxxxxxxx.api.gcp-us-west1.zillizcloud.com
# MILVUS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

# # Elasticsearch (local)
# ELASTICSEARCH_URL=http://elasticsearch:9200
# # e.g: ELASTICSEARCH_URL=http://localhost:9200
# # Use `postgres`/`supabase` to search annotations directly from Supabase
# # PostgreSQL, or `elasticsearch` for the local Docker search service.
# TEXT_SEARCH_BACKEND=postgres

# # --- Object Storage ---
# # Chọn provider: local | mock | r2 | gcs
# STORAGE_PROVIDER=local

# # # Cloudflare R2 (dùng khi STORAGE_PROVIDER=r2)
# # # Lấy từ: R2 Dashboard > Manage R2 API Tokens; Account ID ở trang chủ R2
# # S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# # S3_ACCESS_KEY=<R2_ACCESS_KEY_ID>
# # S3_SECRET_KEY=<R2_SECRET_ACCESS_KEY>
# # S3_BUCKET=multimodal-assets
# # # Bật tại: R2 Dashboard > bucket > Settings > Public Access > Allow Access
# # R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# # # Google Cloud Storage (dùng khi STORAGE_PROVIDER=gcs)
# # # Lấy từ: GCP Console > Cloud Storage > Buckets
# # GCS_BUCKET=multimodal-assets
# # # Path tới service account JSON (bỏ trống nếu dùng ADC / Workload Identity)
# # # Lưu ý: signed URL yêu cầu service account JSON; ADC sẽ fallback sang public URL
# # GCS_CREDENTIALS_FILE=/app/secrets/gcs-sa.json
# # Kaggle/Colab alternative: paste service-account JSON into a secret/env var.
# # Processors can use this directly, and rendered notebook cells materialize it to /tmp/gcs-sa.json.
# # GCS_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# # # Public URL nếu bucket public hoặc có CDN (bỏ trống = dùng storage.googleapis.com mặc định)
# # GCS_PUBLIC_URL=https://storage.googleapis.com/multimodal-assets

# MODEL_REGISTRY_PATH=./configs/model_registry.yaml
# RETRIEVAL_PROFILES_PATH=./configs/retrieval_profiles.yaml
# AGENT_CONFIG_PATH=./configs/agent.yaml
# DATA_ROOT=./demo
# MOCK_MODE=false
# # Mock embedder dim cần khớp với dim của Milvus collection (thường 512)
# MOCK_EMBEDDING_DIM=512

# # --- Local OpenCLIP Embedding Service (apps/backend/scripts/serve_openclip_embeddings.py) ---
# EMBED_HOST=127.0.0.1
# EMBED_PORT=8001
# # EMBED_ENV_FILE=/absolute/path/to/.env

# # --- SigLIP2 Embedding Service (Kaggle/Cloudflare) ---
# SIGLIP2_EMBEDDING_BASE_URL=https://random-name.trycloudflare.com/v1
# SIGLIP2_API_KEY=<your-siglip2-api-key>

# # --- LLM Query Planning Agent ---
# # Default profile uses ChatGroq openai/gpt-oss-120b. Switch to OpenAI with:
# # AGENT_LLM_PROFILE=openai_gpt4o
# AGENT_LLM_PROFILE=groq_gpt_oss_120b
# # GROQ_API_KEY=<your-groq-api-key>
# # OPENAI_API_KEY=<your-openai-api-key>
# # LANGSMITH_TRACING=true
# # LANGSMITH_API_KEY=<your-langsmith-api-key>
# # LANGSMITH_PROJECT=multimodal-retrieval-query-agents

APP_ENV=cloud
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=5173

# Supabase PostgreSQL
# Lấy từ: Supabase Project Dashboard (E.g: AIC2026) > Connect > Direct > Connection Method: Transaction Pooler > Type: URI > Connection string
# Transaction Pooler (port 6543) — khuyến nghị cho serverless/container
# DATABASE_URL=postgresql+psycopg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres.aaboplzhqhnoycklbwdd:Krthienan147158@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres
# e.g: DATABASE_URL=postgresql+psycopg:postgresql://postgres.aaboplzhqhnoycklbwdd:[YOUR-PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres
# DATABASE_URL=postgresql://postgres.teddugdhunzimtpubbgs:aic_2026_supabase@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Redis (local hoặc thay bằng Upstash nếu cần cloud)
REDIS_URL=redis://redis:6379/0
# e.g: REDIS_URL=redis://localhost:6379/0

# Zilliz Cloud (managed Milvus)
# Lấy từ: Zilliz Console > Cluster > Connect > Public Endpoint + API Key
MILVUS_URI=https://your-cluster.serverless.aws-region.cloud.zilliz.com
MILVUS_TOKEN=your-zilliz-api-token
MILVUS_SEARCH_TIMEOUT=12.0

# Elasticsearch (local)
ELASTICSEARCH_URL=http://elasticsearch:9200

# --- Object Storage ---
# Chọn provider: gcs
STORAGE_PROVIDER=gcs
## GG CLOUD
GCS_BUCKET=aic_ai_2026
GCS_CREDENTIALS_FILE=apps\secrets\gen-lang-client-0547522732-410672fac05f.json
GCS_PUBLIC_URL=https://storage.googleapis.com/aic_ai_2026


MODEL_REGISTRY_PATH=./configs/model_registry.yaml
RETRIEVAL_PROFILES_PATH=./configs/retrieval_profiles.yaml
DATA_ROOT=./demo
MOCK_MODE=false
# Mock embedder dim cần khớp với dim của Milvus collection (thường 512)
MOCK_EMBEDDING_DIM=512

# --- Local OpenCLIP Embedding Service (apps/backend/scripts/serve_openclip_embeddings.py) ---
EMBED_HOST=127.0.0.1
EMBED_PORT=8001
# EMBED_ENV_FILE=/absolute/path/to/.env

# --- SigLIP2 Embedding Service (Kaggle/Cloudflare) ---
SIGLIP2_EMBEDDING_BASE_URL=https://random-name.trycloudflare.com/v1
SIGLIP2_API_KEY=<your-siglip2-api-key>

VITE_API_BASE_URL=http://localhost:8000


# --- LLM Query Planning Agent ---
AGENT_CONFIG_PATH=./configs/agent.yaml
# Default profile uses ChatGroq openai/gpt-oss-120b. Switch to OpenAI with:
AGENT_LLM_PROFILE=openai_gpt4o
AGENT_LLM_PROFILE=groq_gpt_oss_120b
